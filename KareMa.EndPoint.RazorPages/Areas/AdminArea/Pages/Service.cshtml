@page
@model KareMa.EndPoint.RazorPages.Pages.Areas.AdminArea.Pages.ServiceModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "سرویس ها | کاره ما";
    ViewData["Service"] = " active open";
    ViewData["PageTitle"] = "سرویس";
}

<div class="card p-5">
    <div class="table-responsive text-nowrap">
        <a asp-page="AddService" class="btn btn-primary">افزودن</a>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>آیدی</th>
                    <th>نام سرویس</th>
                    <th>قیمت</th>
                    <th>نام دسته بندی</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">

                @foreach (var service in Model.Services)
                {
                    @if (service.IsDeleted == false)
                    {
                        <tr>
                            <td>
                                @service.Id
                            </td>

                            <td>@service.Name</td>
                            <td>@service.Price</td>
                            <td>@service.SubCategory.Name</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a asp-page="/UpdateService" asp-route-id="@service.Id">
                                            <i class="bx bx-edit-alt me-1"></i>
                                            ویرایش
                                        </a>
                                        <a asp-page-handler="Delete" asp-route-id="@service.Id" onclick="return confirm('مطمئنی؟')">
                                            <i class="bx bx-trash me-1"></i> حذف
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>