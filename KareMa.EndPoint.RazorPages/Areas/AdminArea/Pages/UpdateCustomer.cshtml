@page
@using KareMa.Domain.Core.Enums
@model KareMa.EndPoint.RazorPages.Areas.AdminArea.Pages.UpdateCustomerModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "  ویرایش مشتری ها | کاره ما";
    ViewData["PageTitle"] = " ویرایش مشتری ها";
}
<div class="col-xxl">
    <div class="card mb-4">
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
            }
            <form method="post" asp-page-handler="Update" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <input type="hidden" asp-for="CustomerUpdate.Id" />
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.FirstName">نام</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.FirstName">
                        <span asp-validation-for="CustomerUpdate.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.LastName">نام خانوادگی</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.LastName">
                        <span asp-validation-for="CustomerUpdate.LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Balance">موجودی</label>
                    <div class="col-sm-10">
                        <input type="number" step="0.01" class="form-control" asp-for="CustomerUpdate.Balance">
                        <span asp-validation-for="CustomerUpdate.Balance" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.PhoneNumber">شماره تلفن</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.PhoneNumber">
                        <span asp-validation-for="CustomerUpdate.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.BankCardNumber">شماره کارت بانکی</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.BankCardNumber">
                        <span asp-validation-for="CustomerUpdate.BankCardNumber" class="text-danger"></span>
                    </div>
                </div>
                <!-- فیلدهای آدرس -->
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Address.Title">عنوان آدرس</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.Address.Title">
                        <span asp-validation-for="CustomerUpdate.Address.Title" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Address.CityId">شهر</label>
                    <div class="col-sm-10">
                        <input type="number" class="form-control" asp-for="CustomerUpdate.Address.CityId">
                        <span asp-validation-for="CustomerUpdate.Address.CityId" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Address.Street">خیابان</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.Address.Street">
                        <span asp-validation-for="CustomerUpdate.Address.Street" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Address.Area">محله</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.Address.Area">
                        <span asp-validation-for="CustomerUpdate.Address.Area" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Address.PostalCode">کدپستی</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" asp-for="CustomerUpdate.Address.PostalCode">
                        <span asp-validation-for="CustomerUpdate.Address.PostalCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="CustomerUpdate.Gender">جنسیت</label>
                    <div class="col-sm-10">
                        <select class="form-control" asp-for="CustomerUpdate.Gender">
                            <option value="@GenderEnum.Female">خانم</option>
                            <option value="@GenderEnum.Male">آقا</option>
                        </select>
                        <span asp-validation-for="CustomerUpdate.Gender" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="Image">آپلود عکس</label>
                    <div class="col-sm-10">
                        <input type="file" class="form-control" asp-for="Image">
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">عکس فعلی</label>
                    <div class="col-sm-10">
                        @if (string.IsNullOrEmpty(Model.CustomerUpdate.Image))
                        {
                            <img src="~/assets/img/none.png" width="150px" height="100px" />
                        }
                        else
                        {
                            <img src="@Model.CustomerUpdate.Image" width="150px" height="100px" />
                        }
                    </div>
                </div>
                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">ارسال</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}