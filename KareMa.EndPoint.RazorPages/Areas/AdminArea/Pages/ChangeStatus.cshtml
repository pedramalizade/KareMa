<div class="col-xxl">
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" asp-page-handler="ChangeStatus">
                <input type="hidden" asp-for="OrderId" value="@Model.Order.Id" />

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label" asp-for="Status">وضعیت سفارش</label>
                    <div class="col-sm-10">
                        <div class="input-group">
                            <select class="form-select form-select-lg select2" asp-for="Status"
                                    asp-items="Html.GetEnumSelectList<StatusEnum>()">
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">ذخیره</button>
                        <a asp-page="Index" class="btn btn-warning">بازگشت</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
