@page
@using KareMa.Domain.Core.Enums
@model KareMa.EndPoint.RazorPages.Pages.Areas.AdminArea.Pages.ChangeStatusModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "   تغییر وضعیت | کاره ما";
    ViewData["PageTitle"] = "تغییر وضعیت";
}


