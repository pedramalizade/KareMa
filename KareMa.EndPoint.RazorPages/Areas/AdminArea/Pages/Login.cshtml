@page
@model KareMa.EndPoint.RazorPages.Areas.AdminArea.Pages.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "ورود ادمین";
}
<section class="gray">
    <div class="container">
        <div class="row align-items-start justify-content-center">
            <div class="col-xl-5 col-lg-8 col-md-12">
                <div class="signup-screen-wrap">
                    <div class="signup-screen-single">
                        <div class="text-center mb-4">
                            <h4 class="m-0 ft-medium">ورود به حساب ادمین</h4>
                        </div>

                        <form class="submit-form" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                            <div class="form-group">
                                <label asp-for="Input.Email" class="mb-1">ایمیل</label>
                                <input type="email" asp-for="Input.Email" class="form-control rounded" placeholder="ایمیل خود را وارد کنید">
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Input.Password" class="mb-1">رمز عبور</label>
                                <input type="password" asp-for="Input.Password" class="form-control rounded" placeholder="رمز عبور خود را وارد کنید">
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-md full-width theme-bg text-light rounded ft-medium">ورود</button>
                            </div>

                            <div class="form-group text-center mt-4 mb-0">
                                <p class="mb-0">حساب ندارید؟ با ادمین سیستم تماس بگیرید.</p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}