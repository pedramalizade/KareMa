@page
@using KareMa.Domain.Core.Enums
@model KareMa.EndPoint.RazorPages.Areas.AdminArea.Pages.RegisterModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "‌افزودن کاربر جدید | کاره ما";
    ViewData["Register"] = "active open";
    ViewData["PageTitle"] = "افزودن ادمین جدید";
}

<div class="card">
    <div class="card-body">
        <div class="container d-flex align-items-center justify-content-center">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center col-lg-6" role="alert">
                    <h6 class="alert-heading mb-1">ادمین جدید در سیستم ثبت شد!</h6>
                </div>
            }
        </div>
        <div class="d-flex align-items-center justify-content-center">
            <form class="w-px-400 border rounded p-3 p-md-5" method="post">
                <h3 class="mb-4">افزودن ادمین</h3>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.FirstName">نام</label>
                    <input type="text" asp-for="Input.FirstName" class="form-control text-start" dir="rtl" placeholder="نام خود را وارد کنید">
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Input.LastName">نام خانوادگی</label>
                    <input type="text" asp-for="Input.LastName" class="form-control text-start" dir="rtl" placeholder="نام خانوادگی خود را وارد کنید">
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Gender" class="form-label">جنسیت</label>
                    <select type="text" asp-for="Input.Gender" class="form-control text-start" dir="rtl">
                        <option value="@GenderEnum.Female">خانم</option>
                        <option value="@GenderEnum.Male">آقا</option>
                    </select>
                    <span asp-validation-for="Input.Gender" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Balance" class="form-label">موجودی</label>
                    <input type="number" step="0.01" asp-for="Input.Balance" class="form-control text-start" dir="ltr" placeholder="موجودی اولیه (اختیاری)">
                    <span asp-validation-for="Input.Balance" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">ایمیل</label>
                    <input type="email" asp-for="Input.Email" class="form-control text-start" dir="ltr" placeholder="ایمیل خود را وارد کنید">
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3 form-password-toggle">
                    <label asp-for="Input.Password" class="form-label">رمز عبور</label>
                    <div class="input-group input-group-merge">
                        <input type="password" asp-for="Input.Password" class="form-control text-start" dir="ltr" placeholder="رمز عبور خود را وارد کنید" aria-describedby="form-alignment-password2">
                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-password-toggle">
                    <label asp-for="Input.ConfirmPassword" class="form-label">تأیید رمز عبور</label>
                    <div class="input-group input-group-merge">
                        <input type="password" asp-for="Input.ConfirmPassword" class="form-control text-start" dir="ltr" placeholder="رمز عبور را دوباره وارد کنید" aria-describedby="form-alignment-password2">
                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">ثبت</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}