@page
@using KareMa.Domain.Core.Enums
@model KareMa.EndPoint.RazorPages.Areas.CustomerArea.Pages.Shared.CustomerProfileSettingModel
@{
    Layout = "_CustomerLayout";
    ViewData["ProfileSetting"] = "active";
}
<div class="goodup-dashboard-content">
    <div class="dashboard-tlbar d-block mb-5">
        <div class="row">
            <div class="colxl-12 col-lg-12 col-md-12">
                <h1 class="ft-medium fs-lg">پروفایل</h1>
            </div>
        </div>
    </div>

    <div class="dashboard-widg-bar d-block">
        <div class="row">
            <div class="col-xl-12 col-lg-12">
                <div class="dashboard-list-wraps bg-white rounded mb-4">
                    <div class="dashboard-list-wraps-head br-bottom py-3 px-3">
                        <div class="dashboard-list-wraps-flx">
                            <h4 class="mb-0 ft-medium fs-md"><i class="fa fa-file-alt ms-2 theme-cl fs-sm"></i>تنظیمات پروفایل</h4>
                        </div>
                    </div>
                    <div class="text-danger" style="margin-bottom: 10px;">
                        @Html.ValidationSummary(true)
                    </div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    <form class="submit-form" method="post" enctype="multipart/form-data" asp-page-handler="Update">
                        <div class="text-danger" style="margin-bottom: 10px;">
                            @Html.ValidationSummary(true)
                        </div>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success" role="alert">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        <div class="dashboard-widg-bar d-block">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-8 col-sm-12">
                                    <div class="dashboard-list-wraps bg-white rounded mb-4">
                                        <div class="dashboard-list-wraps-head br-bottom py-3 px-3">
                                            <div class="dashboard-list-wraps-flx">
                                                <h4 class="mb-0 ft-medium fs-md"><i class="fa fa-user-check ms-2 theme-cl fs-sm"></i>مشخصات شخصی</h4>
                                            </div>
                                        </div>

                                        <div class="dashboard-list-wraps-body py-3 px-3">
                                            <div class="row">
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">نام</label>
                                                        <input asp-for="CustomerUpdate.FirstName" type="text" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.FirstName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">نام خانوادگی</label>
                                                        <input asp-for="CustomerUpdate.LastName" type="text" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.LastName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="form-group">
                                                        <label asp-for="CustomerUpdate.Gender" class="mb-1">جنسیت</label>
                                                        <select class="form-control rounded" asp-for="CustomerUpdate.Gender">
                                                            <option value="">انتخاب کنید</option>
                                                            <option value="@GenderEnum.Female">خانم</option>
                                                            <option value="@GenderEnum.Male">آقا</option>
                                                        </select>
                                                        <span asp-validation-for="CustomerUpdate.Gender" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">شماره تلفن</label>
                                                        <input type="text" asp-for="CustomerUpdate.PhoneNumber" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.PhoneNumber" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">کارت بانکی</label>
                                                        <input type="text" asp-for="CustomerUpdate.BankCardNumber" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.BankCardNumber" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">موجودی</label>
                                                        <input type="number" asp-for="CustomerUpdate.Balance" class="form-control rounded" step="0.01" />
                                                        <span asp-validation-for="CustomerUpdate.Balance" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">عکس پروفایل</label>
                                                        <input type="file" asp-for="Image" class="form-control rounded" />
                                                        <div class="mt-2">
                                                            @if (!string.IsNullOrEmpty(Model.CustomerUpdate.Image))
                                                            {
                                                                <img src="@Model.CustomerUpdate.Image" width="150px" height="100px" />
                                                            }
                                                            else
                                                            {
                                                                <img src="~/assets/img/none.png" width="150px" height="100px" />
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="dashboard-list-wraps-head br-bottom p-3">
                                                <div class="dashboard-list-wraps-flx">
                                                    <h4 class="mb-0 ft-medium fs-md"><i class="fa fa-user-check ms-2 theme-cl fs-sm"></i>آدرس</h4>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 pt-3">
                                                    <div class="form-group">
                                                        <label class="mb-1">انتخاب شهر محل سکونت</label>
                                                        <select class="form-control rounded" asp-for="CustomerUpdate.Address.CityId" asp-items="@(new SelectList(Model.Cities, "Id", "Name"))">
                                                            <option value="">انتخاب کنید</option>
                                                        </select>
                                                        <span asp-validation-for="CustomerUpdate.Address.CityId" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 pt-3">
                                                    <div class="form-group">
                                                        <label class="mb-1">نام خیابان</label>
                                                        <input asp-for="CustomerUpdate.Address.Street" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.Address.Street" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">نام محله و نام کوچه و ...</label>
                                                        <input asp-for="CustomerUpdate.Address.Area" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.Address.Area" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 pt-3">
                                                    <div class="form-group">
                                                        <label class="mb-1">عنوان آدرس (مثلاً خانه یا محل کار)</label>
                                                        <input asp-for="CustomerUpdate.Address.Title" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.Address.Title" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                    <div class="form-group">
                                                        <label class="mb-1">کدپستی</label>
                                                        <input type="text" asp-for="CustomerUpdate.Address.PostalCode" class="form-control rounded" />
                                                        <span asp-validation-for="CustomerUpdate.Address.PostalCode" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                                <div class="form-group">
                                                    <button type="submit" class="btn theme-bg rounded text-light">ذخیره تغییرات</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


