@page
@model KareMa.EndPoint.RazorPages.Pages.SubCategoryModel
@{
}
<section class="gray py-5">
    <div class="container">
        <div class="row justify-content-center">
            @foreach (var item in Model.SubCategories)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="Goodup-grid-wrap">
                        <div class="Goodup-grid-upper">
                            <a asp-page="Service" asp-route-id="@item.Id" class="d-block text-center m-auto">
                                <div class="Goodup-grid-thumb">
                                    <img src="@item.Image" class="img-fluid" alt="@item.Name">
                                </div>
                            </a>
                        </div>
                        <div class="Goodup-grid-fl-wrap">
                            <div class="Goodup-caption px-3 p-4 text-center">
                                <h4 class="mb-0 ft-medium">@item.Name</h4>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>